<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://android.com"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#121212"
    android:padding="12dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#075E54"
        android:padding="14dp"
        android:text="📡 ऑफ़लाइन मेश कॉल और चैट"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold"
        android:gravity="center" />

    <TextView
        android:id="@+id/statusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="8dp"
        android:text="आस-पास के फ़ोन खोज रहा है..."
        android:textColor="#25D366"
        android:textSize="14sp"
        android:gravity="center" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#1E1E1E"
        android:padding="10dp"
        android:layout_marginBottom="10dp">

        <TextView
            android:id="@+id/chatDisplay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="बिना इंटरनेट बात करने के लिए नीचे बटन दबाकर बोलें या मैसेज लिखें...\n"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:lineSpacingExtra="4dp" />
    </ScrollView>

    <!-- वॉकी-टॉकी बोलने वाला बटन -->
    <Button
        android:id="@+id/pttBtn"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:layout_marginBottom="10dp"
        android:backgroundTint="#FF5722"
        android:text="🎙️ दबाकर बोलें (Hold to Talk)"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold" />

    <!-- नीचे मैसेज लिखने और भेजने का बॉक्स -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/messageInput"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="#2C2C2C"
            android:hint="मैसेज लिखें..."
            android:textColor="#FFFFFF"
            android:textColorHint="#888888"
            android:padding="12dp"
            android:textSize="16sp" />

        <Button
            android:id="@+id/sendBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:backgroundTint="#25D366"
            android:text="भेजें"
            android:textColor="#000000"
            android:textStyle="bold"
            android:padding="12dp" />
    </LinearLayout>

</LinearLayout>
